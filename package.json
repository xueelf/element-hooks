{
  "name": "element-hooks",
  "version": "1.0.5",
  "description": "Using Hooks in Element Plus.",
  "keywords": [
    "vue",
    "vue3",
    "hooks",
    "utils",
    "element",
    "element-plus",
    "element-hooks"
  ],
  "homepage": "https://element-hooks.js.org",
  "bugs": {
    "url": "https://github.com/xueelf/element-hooks/issues"
  },
  "author": "Yuki <admin@yuki.sh>",
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "type": "module",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./composables": {
      "import": "./lib/composables/index.js",
      "types": "./lib/composables/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/element-hooks.git"
  },
  "scripts": {
    "build": "bun scripts/build/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write \"**/*.{ts,tsx,vue}\"",
    "lint": "eslint \"**/*.{ts,tsx,vue}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^9.39.2",
    "@iconify-json/ep": "^1.2.4",
    "@types/bun": "^1.3.9",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "radash": "^12.1.1",
    "sass-embedded": "^1.97.3",
    "tsc-alias": "^1.8.16",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.0.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitepress": "^2.0.0-alpha.16"
  },
  "peerDependencies": {
    "element-plus": "^2.11.0",
    "typescript": "^5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
