{
  "name": "element-hooks",
  "version": "1.2.4",
  "description": "Using Hooks in Element Plus.",
  "keywords": [
    "element",
    "element-hooks",
    "element-plus",
    "hooks",
    "utils",
    "vue",
    "vue3"
  ],
  "homepage": "https://element-hooks.js.org",
  "bugs": {
    "url": "https://github.com/xueelf/element-hooks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/element-hooks.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./dist/*.d.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "default": "./dist/composables/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier \"**/*.{json,md,ts,tsx,vue,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{json,md,ts,tsx,vue,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ep": "^1.2.4",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "annal": "^0.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sort": "^1.0.1",
    "sass-embedded": "^1.102.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitepress": "^2.0.0-alpha.19",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "element-plus": "^2.14.5",
    "typescript": "^6.0.3",
    "vue": "^3.5.41"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
