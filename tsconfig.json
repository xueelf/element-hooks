{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleDetection": "force",
    "types": ["bun"],

    /* Modules */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./*"],
      "#/*": ["./src/*"],
      "element-hooks": ["./src/index"]
    },
    "allowImportingTsExtensions": true,

    /* Emit */
    "noEmit": true,
    "outDir": "dist",

    /* Interop Constraints */
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": ["*.config.ts", "docs", "scripts", "src"]
}
