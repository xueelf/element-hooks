{
  "compilerOptions": {
    /* Language and Environment */
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleDetection": "force",

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": "./",
    "paths": {
      "element-hooks": ["./src/index"],
    },
    "allowImportingTsExtensions": true,

    /* Emit */
    "noEmit": true,

    /* Interop Constraints */
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noFallthroughCasesInSwitch": true,

    /* Completeness */
    "skipLibCheck": true,
  },
  "include": [
    "docs/**/*.vue",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/*.d.ts",
  ],
}
